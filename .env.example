# Copy to .env and fill in real values. .env is gitignored -- never commit
# real secrets, and never commit .env itself.
#
# Used by: infra/docker-compose.yml (api + worker services, env_file: .env)
# and locally by server/app/config.py (same variable names, no prefix).

# --- database ---
# In Docker, host is the "db" service name; locally, use localhost.
DATABASE_URL=postgresql+psycopg://parakh:parakh_dev_pw@db:5432/parakh

# --- assessor/admin JWT auth (server/app/auth.py) ---
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MUST be set to a real random value outside local dev -- the app falls
# back to a random value generated at process startup if unset, which is
# fine for a single dev process but invalidates every token on restart.
JWT_SECRET=replace-with-a-random-32-byte-urlsafe-string
JWT_ALGORITHM=HS256
JWT_ISSUER=kaushalpramaan
JWT_AUDIENCE=kaushalpramaan-dashboard
JWT_EXPIRE_MINUTES=60

# --- worker capability tokens (docs/worker_capability_tokens.md) ---
WORKER_TOKEN_BYTES=32

# --- evidence storage (server/app/storage.py) ---
# In Docker this is the mounted "evidence" named volume (see
# infra/docker-compose.yml); locally it defaults under server/data/.
EVIDENCE_DIR=/data/evidence

# --- resumable uploads ---
UPLOAD_SESSION_TTL_MINUTES=120
UPLOAD_CHUNK_MAX_BYTES=2097152

# --- background worker (server/app/worker.py) ---
JOB_POLL_INTERVAL_SECONDS=2.0
JOB_MAX_ATTEMPTS=3

# --- dev-only assessor bootstrap (server/app/seed.py) ---
# Leave unset in any shared/deployed environment. If unset, the seeded
# assessor has no password and simply cannot log in -- seeding never
# hard-codes a credential.
DEV_ASSESSOR_EMAIL=assessor.demo@parakh.test
DEV_ASSESSOR_PASSWORD=change-me-dev-only
