{
  "$defs": {
    "AssistanceAnalysis": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/AssistanceCoverage"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssistanceProvenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewRecommended": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewrecommended"
        },
        "status": {
          "enum": [
            "COMPLETED",
            "PARTIAL",
            "FAILED",
            "UNAVAILABLE"
          ],
          "title": "Status",
          "type": "string"
        },
        "visibleRatio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visibleratio"
        },
        "visibleRatioGapFilled": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visibleratiogapfilled"
        }
      },
      "required": [
        "status",
        "provenance",
        "coverage"
      ],
      "title": "AssistanceAnalysis",
      "type": "object"
    },
    "AssistanceCoverage": {
      "additionalProperties": false,
      "properties": {
        "analysedSamples": {
          "maximum": 2400,
          "minimum": 0,
          "title": "Analysedsamples",
          "type": "integer"
        },
        "coveredDurationMs": {
          "maximum": 1200000,
          "minimum": 0,
          "title": "Covereddurationms",
          "type": "integer"
        },
        "motionAnalysedPairs": {
          "default": 0,
          "maximum": 1200,
          "minimum": 0,
          "title": "Motionanalysedpairs",
          "type": "integer"
        },
        "motionRequestedPairs": {
          "default": 0,
          "maximum": 1200,
          "minimum": 0,
          "title": "Motionrequestedpairs",
          "type": "integer"
        },
        "requestedSamples": {
          "maximum": 2400,
          "minimum": 0,
          "title": "Requestedsamples",
          "type": "integer"
        }
      },
      "required": [
        "requestedSamples",
        "analysedSamples",
        "coveredDurationMs"
      ],
      "title": "AssistanceCoverage",
      "type": "object"
    },
    "AssistanceFlag": {
      "additionalProperties": false,
      "properties": {
        "endMs": {
          "anyOf": [
            {
              "maximum": 1200000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endms"
        },
        "observed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "severity": {
          "const": "review",
          "default": "review",
          "title": "Severity",
          "type": "string"
        },
        "startMs": {
          "default": 0,
          "maximum": 1200000,
          "minimum": 0,
          "title": "Startms",
          "type": "integer"
        },
        "threshold": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "type": {
          "enum": [
            "DARK",
            "OVEREXPOSED",
            "BLURRY",
            "CAMERA_MOTION",
            "HANDS_NOT_DETECTED"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "AssistanceFlag",
      "type": "object"
    },
    "AssistanceProvenance": {
      "additionalProperties": false,
      "properties": {
        "modelSha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modelsha256"
        },
        "moduleVersion": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Moduleversion",
          "type": "string"
        },
        "profileSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Profilesha256",
          "type": "string"
        },
        "profileVersion": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Profileversion",
          "type": "string"
        },
        "sampleIntervalMs": {
          "const": 1000,
          "default": 1000,
          "title": "Sampleintervalms",
          "type": "integer"
        }
      },
      "required": [
        "moduleVersion",
        "profileVersion",
        "profileSha256"
      ],
      "title": "AssistanceProvenance",
      "type": "object"
    }
  },
  "$id": "urn:kaushalpramaan:assistance:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Signed on-device advisory snapshot. Cross-field intervals, coverage, status and evidence binding also require semantic validation; see docs/evidence_quality_result.md.",
  "properties": {
    "assessmentId": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Assessmentid",
      "type": "string"
    },
    "completedAtMillis": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completedatmillis"
    },
    "contractVersion": {
      "const": 1,
      "default": 1,
      "title": "Contractversion",
      "type": "integer"
    },
    "durationMs": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Durationms"
    },
    "errorCategory": {
      "anyOf": [
        {
          "enum": [
            "CANCELLED",
            "INTERRUPTED",
            "MEDIA_UNAVAILABLE",
            "INPUT_CHANGED",
            "ANALYSIS_FAILED",
            "MODEL_UNAVAILABLE",
            "INCOMPLETE_COVERAGE",
            "PAYLOAD_LIMIT"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Errorcategory"
    },
    "evidenceId": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Evidenceid",
      "type": "string"
    },
    "flags": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AssistanceFlag"
      },
      "maxItems": 256,
      "title": "Flags",
      "type": "array"
    },
    "hands": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssistanceAnalysis"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "intervalsTruncated": {
      "default": false,
      "title": "Intervalstruncated",
      "type": "boolean"
    },
    "mediaSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Mediasha256",
      "type": "string"
    },
    "quality": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssistanceAnalysis"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "revisionId": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Revisionid",
      "type": "string"
    },
    "revisionNumber": {
      "minimum": 1,
      "title": "Revisionnumber",
      "type": "integer"
    },
    "source": {
      "const": "ON_DEVICE",
      "default": "ON_DEVICE",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "QUEUED",
        "RUNNING",
        "COMPLETED",
        "PARTIAL",
        "FAILED",
        "UNAVAILABLE"
      ],
      "title": "Status",
      "type": "string"
    },
    "taskId": {
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5"
      ],
      "title": "Taskid",
      "type": "string"
    }
  },
  "required": [
    "assessmentId",
    "taskId",
    "evidenceId",
    "revisionId",
    "revisionNumber",
    "mediaSha256",
    "status"
  ],
  "title": "AssistanceSnapshot",
  "type": "object"
}
