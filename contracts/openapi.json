  "info": {
    "title": "KaushalPramaan API",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/packs/import": {
      "post": {
        "description": "Admin-only. Re-validates with tools/pack_validate.py and\ntools/audit_qp_traceability.py before importing -- see pack_import.py.",
        "operationId": "import_pack_endpoint_admin_packs_import_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PackImportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackImportOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Import Pack Endpoint",
        "tags": [
          "admin"
        ]
      }
    },
    "/assessments": {
      "post": {
        "description": "Open to any caller (the worker app has no login) -- the response\ncarries a fresh, unguessable capability token that every subsequent\nworker-side call on this assessment must present. See\ndocs/worker_capability_tokens.md.",
        "operationId": "create_assessment_assessments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssessmentCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentCreatedOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Assessment",
        "tags": [
          "assessments"
        ]
      }
    },
    "/assessments/{assessment_id}": {
      "get": {
        "operationId": "get_assessment_assessments__assessment_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "assessment_id",
            "required": true,
            "schema": {
              "title": "Assessment Id",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "x-worker-token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Worker-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Assessment",
        "tags": [
          "assessments"
        ]
      }
    },
    "/assessments/{assessment_id}/rubric": {
      "get": {
        "description": "Assessor/admin only -- the 0-3 anchors for this assessment's pack,\nfor the dashboard's assessment-review page.",
        "operationId": "get_assessment_rubric_assessments__assessment_id__rubric_get",
        "parameters": [
          {
            "in": "path",
            "name": "assessment_id",
            "required": true,
            "schema": {
              "title": "Assessment Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RubricItemOut"
                  },
                  "title": "Response Get Assessment Rubric Assessments  Assessment Id  Rubric Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Assessment Rubric",
        "tags": [
          "assessments"
        ]
      }
    },
