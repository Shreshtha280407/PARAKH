# Local SDK path, machine-specific -- never committed.
local.properties

# Gradle
.gradle/
build/
*/build/
*/*/build/
.kotlin/

# IntelliJ/Android Studio's own out-of-Gradle Kotlin compiler output (separate
# from Gradle's build/ above -- produced when the IDE compiles a module
# directly). core/mapping/bin/ was accidentally committed once; this is the
# narrow rule for that exact generated path, mirrored for every module depth
# this project has (app/, core/mapping/).
bin/
*/bin/
*/*/bin/

# Android Studio / IntelliJ
.idea/
*.iml
.navigation/
captures/
.externalNativeBuild/
.cxx/

# Instrumented-test artifacts (logs/screenshots), see docs/gates/P3.md
test-artifacts/

# P4: signing keystores -- none is checked in; this is a guard against ever
# accidentally adding one (debug.keystore, a release keystore, etc).
*.jks
*.keystore

# P4: local SQLCipher-encrypted draft database and its WAL/SHM siblings, and
# any local debug dump of private draft evidence pulled off-device for
# inspection -- none of this is ever meant to be committed. The real, live
# versions of these only ever exist in the app's private on-device storage;
# this rule only guards against someone's local working copy landing in the
# repo tree by accident (e.g. via `adb pull` into the project directory).
*.db
*.db-wal
*.db-shm
/local-debug-evidence/

# P5: local test video fixtures pulled off-device, local decrypted debug-export dumps, and
# any local copy of the Tink keyset/vault SharedPreferences files -- same reasoning as the P4
# rule above. The real versions only ever exist in the app's private on-device storage
# (files/vault/, files/p5_debug_export/) or inside Android's own app-private shared_prefs/;
# this only guards a local working copy landing in the repo tree by accident.
/local-debug-export/
*.vault
kp_vault_keyset_prefs.xml
kp_seal_test_key*
