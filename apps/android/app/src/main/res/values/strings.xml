    <!-- Consent screen -->
    <string name="consent_title">Before you start</string>
    <string name="consent_body">PARAKH will ask you about your past electrical work experience and let you record practice evidence. Your answers and evidence are stored privately on this phone. After you seal an assessment, the app sends its declaration and evidence to the assessment server when a connection is available for a human assessor to review. These practice results do not certify, qualify, pass or fail you. You can stop at any time.</string>
    <string name="consent_play_audio">Play this out loud</string>
    <string name="consent_audio_unavailable">Audio playback is not available on this device right now — you can still read the text above.</string>
    <string name="consent_checkbox">I have read or heard this and I agree to continue.</string>
    <string name="consent_continue_disabled_hint">Please agree to the consent above to continue.</string>

