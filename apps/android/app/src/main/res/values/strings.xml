    <!-- Consent screen -->
    <string name="consent_title">Before you start</string>
    <string name="consent_body">KaushalPramaan will ask you about your past electrical work experience and let you record practice evidence on this phone. Nothing leaves this phone in this version of the app — there is no internet upload here. Your answers help a human assessor understand your experience; they do not certify, qualify, pass or fail you. You can stop at any time.</string>
    <string name="consent_play_audio">Play this out loud</string>
    <string name="consent_audio_unavailable">Audio playback is not available on this device right now — you can still read the text above.</string>
    <string name="consent_checkbox">I have read or heard this and I agree to continue.</string>
    <string name="consent_continue_disabled_hint">Please agree to the consent above to continue.</string>

