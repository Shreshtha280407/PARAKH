    <!-- Match result screen -->
    <string name="match_title">असिस्टेंट इलेक्ट्रीशियन से आपका मैच</string>
    <string name="match_result_appropriate">उपयुक्त मैच</string>
    <string name="match_result_partial">आंशिक मैच — कुछ कमियां</string>
    <string name="match_result_not_appropriate">अभी उपयुक्त मैच नहीं है</string>
    <string name="match_disclaimer">यह केवल यह बताता है कि आपका बताया हुआ अनुभव असिस्टेंट इलेक्ट्रीशियन (CON/Q0602) के व्यावहारिक मूल्यांकन के लिए कितना उपयुक्त है। यह कोई प्रमाणपत्र, पास, फेल या योग्यता नहीं है — आपके अभ्यास प्रमाण देखने के बाद अंतिम निर्णय एक व्यक्ति (असेसर) लेता है।</string>
    <string name="match_because_title">यह परिणाम क्यों आया</string>
    <string name="match_gaps_title">कम बताए गए अनुभव वाले क्षेत्र</string>
    <string name="match_no_gaps">कोई कमी नहीं — आपने सभी क्षेत्रों में अनुभव बताया है।</string>
    <string name="match_coverage_label">कुल बताया गया अनुभव कवरेज: %1$d%%</string>
