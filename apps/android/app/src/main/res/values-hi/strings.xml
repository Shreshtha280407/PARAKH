    <!-- Consent screen -->
    <string name="consent_title">शुरू करने से पहले</string>
    <string name="consent_body">कौशलप्रमाण आपसे बिजली के काम के आपके पुराने अनुभव के बारे में पूछेगा और आपको इस फ़ोन पर अभ्यास का प्रमाण रिकॉर्ड करने देगा। ऐप के इस संस्करण में कुछ भी फ़ोन से बाहर नहीं जाता — यहाँ इंटरनेट पर कुछ भी अपलोड नहीं होता। आपके जवाब एक व्यक्ति (असेसर) को आपका अनुभव समझने में मदद करते हैं; ये आपको प्रमाणित, योग्य, पास या फेल नहीं करते। आप किसी भी समय रुक सकते हैं।</string>
    <string name="consent_play_audio">इसे ज़ोर से सुनें</string>
    <string name="consent_audio_unavailable">इस समय इस फ़ोन पर आवाज़ चलाना संभव नहीं है — आप ऊपर लिखा हुआ पढ़ सकते हैं।</string>
    <string name="consent_checkbox">मैंने यह पढ़ा/सुना है और आगे बढ़ने के लिए सहमत हूँ।</string>
    <string name="consent_continue_disabled_hint">आगे बढ़ने के लिए कृपया ऊपर दी गई सहमति से सहमत हों।</string>

