    <!-- Task detail screen -->
    <string name="task_detail_safety_warning">सुरक्षा: केवल बंद (डी-एनर्जाइज़्ड) ट्रेनिंग बोर्ड या निगरानी वाली ट्रेनिंग जगह का उपयोग करें। यह ऐप कभी भी लाइव बिजली के काम का निर्देश नहीं देता।</string>
    <string name="task_detail_guide_title">यह कार्य कैसे करें</string>
