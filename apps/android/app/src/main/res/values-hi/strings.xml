    <!-- Task list screen -->
    <string name="tasks_title">अभ्यास कार्य</string>
    <string name="tasks_subtitle">हर कार्य के लिए अभ्यास प्रमाण एक बंद (डी-एनर्जाइज़्ड) ट्रेनिंग बोर्ड पर, निगरानी में रिकॉर्ड करें। ये अभ्यास कार्य हैं, लाइव काम का निर्देश नहीं।</string>
    <string name="tasks_budget_total">कुल इस्तेमाल किया गया प्रमाण: %2$s में से %1$s</string>
