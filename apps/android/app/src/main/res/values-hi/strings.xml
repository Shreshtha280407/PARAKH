    <!-- Declaration screen -->
    <string name="declaration_title">अपने अनुभव के बारे में बताएं</string>
    <string name="declaration_instructions">हर वाक्य के लिए बताएं कि यह आपके काम को कितनी बार दर्शाता है। यह सिर्फ़ आपको सही अभ्यास कार्यों तक पहुंचाने के लिए है — यह कोई परीक्षा नहीं है।</string>
    <string name="declaration_section_tools">बिजली से जुड़ा व्यावहारिक अनुभव</string>
    <string name="declaration_section_safety">सुरक्षा और पीपीई</string>
    <string name="declaration_section_teamwork">दूसरों के साथ काम करना</string>
    <string name="declaration_section_planning">अपने काम की योजना बनाना</string>
    <string name="declaration_section_tools_grid">आपने इनमें से कौन से औज़ार इस्तेमाल किए हैं?</string>
    <string name="declaration_years_label">अनुभव के वर्ष (किसी भी बिजली से जुड़े काम का)</string>
    <string name="declaration_free_text_label">कुछ और जोड़ना चाहते हैं? (वैकल्पिक)</string>
    <string name="declaration_free_text_hint">आप अंग्रेज़ी, हिन्दी या दोनों मिलाकर लिख सकते हैं — जैसे \"maine earthing kiya\"</string>
