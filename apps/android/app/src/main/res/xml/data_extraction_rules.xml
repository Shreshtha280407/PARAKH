<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ cloud-backup and device-to-device transfer rules. allowBackup="false" in the
  manifest already disables classic backup, Auto Backup, and D2D transfer entirely on this
  OS range, so these excludes are defense-in-depth documentation of intent, not the primary
  control: if allowBackup is ever flipped on by a future change, the P4 encrypted database,
  its Keystore-wrapped passphrase, and every private draft evidence file still never leave
  this device through either path below.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" path="kp_db_key_store.xml" />
        <exclude domain="file" path="drafts/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" path="kp_db_key_store.xml" />
        <exclude domain="file" path="drafts/" />
    </device-transfer>
</data-extraction-rules>
