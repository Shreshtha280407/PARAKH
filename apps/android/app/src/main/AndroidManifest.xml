<?xml version="1.0" encoding="utf-8"?>
<!--
  P-3 is offline-first by construction: this manifest deliberately declares
  NO android.permission.INTERNET and NO ACCESS_NETWORK_STATE. Every screen
  must work with the phone in airplane mode; app/build.gradle.kts's
  verifyNoNetworkDependencies task fails the build if either permission is
  ever added. Upload/sync is explicitly out of P-3 scope (see
  SubmittedScreen's on-screen explanation).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.KaushalPramaan"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|locale|layoutDirection"
            android:theme="@style/Theme.KaushalPramaan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
